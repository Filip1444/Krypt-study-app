{
  "name": "krypt",
  "version": "1.6.2",
  "description": "KRYPT desktop app",
  "author": "KRYPT",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder -p never",
    "dist:win": "electron-builder --win -p never",
    "dist:linux": "electron-builder --linux --config.directories.output=release_linux -p never",
    "dist:mac": "electron-builder --mac --config.directories.output=release_macOS -p never"
  },
  "build": {
    "appId": "com.krypt.desktop",
    "productName": "KRYPT",
    "directories": {
      "output": "release"
    },
    "files": [
      "main.js",
      "data-schema.js",
      "preload.js",
      "src/**/*",
      "!src/**/*.bak",
      "assets/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "assets/icon.ico"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Education",
      "icon": "icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true
    },
    "mac": {
      "target": "dmg",
      "icon": "icon.png",
      "category": "public.app-category.education"
    },
    "forceCodeSigning": false
  },
  "devDependencies": {
    "electron": "^44.5.1",
    "electron-builder": "^26.15.3"
  }
}
